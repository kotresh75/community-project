# ==============================================================================
# C.R.E.A.M. Project .gitignore
# Community Renewable Energy Awareness & Management Portal (VTU 1BCP308)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Credentials (Security Sensitive)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.cert
credentials.json
token.json

# ------------------------------------------------------------------------------
# 2. Node.js & Frontend Build Artifacts
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Vite & Bundler cache
.vite/
frontend/.vite/
frontend/node_modules/.vite/
.cache/
frontend/dist/
dist/

# ------------------------------------------------------------------------------
# 3. Python & Backend Bytecode / Caches
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
**/*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
htmlcov/
.pytest_cache/

# ------------------------------------------------------------------------------
# 4. Local SQLite Databases & Volatile Runtime State
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3

# ------------------------------------------------------------------------------
# 5. Operating System & Office Temporary Files
# ------------------------------------------------------------------------------
# Linux & LibreOffice lock files
.~lock.*#
*.tmp
*.temp

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# 6. IDEs & Text Editors
# ------------------------------------------------------------------------------
.idea/
*.swp
*.swo
*.swn
*~
.project
.classpath
.c9/
*.launch
.settings/

# VS Code (ignore workspace state, keep recommendations if needed)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

